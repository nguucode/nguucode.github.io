---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", (p) => !p.data.draft);
  return projects.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <p class="faint"><a href="/projects/">← Projects</a></p>

  <h1>{entry.data.title}</h1>
  <p class="entry-meta">
    {entry.data.role} · {entry.data.year}{entry.data.client ? ` · ${entry.data.client}` : ""}
  </p>
  <p class="lede">{entry.data.summary}</p>

  <div class="prose">
    <Content />
  </div>
</Base>
