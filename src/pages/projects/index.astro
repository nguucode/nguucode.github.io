---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Projects" description="Selected UI/UX case studies.">
  <h1>Projects</h1>
  <p class="lede">Năm case study. Vấn đề, vai trò, quá trình, kết quả.</p>

  {
    projects.length === 0 ? (
      <div class="empty">
        <p style="margin:0 0 .6rem">Chưa có case study nào được publish.</p>
        <p style="margin:0" class="faint">
          Mỗi case study là một file <code>.md</code> trong{" "}
          <code>src/content/projects/</code>. Xem{" "}
          <code>_template.md</code> để biết cấu trúc.
        </p>
      </div>
    ) : (
      <ul class="entries">
        {projects.map((p) => (
          <li>
            <a class="entry-title" href={`/projects/${p.id}/`}>
              {p.data.title}
            </a>
            <div class="entry-meta">
              {p.data.role} · {p.data.year}
              {p.data.client ? ` · ${p.data.client}` : ""}
            </div>
            <p class="entry-note">{p.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
