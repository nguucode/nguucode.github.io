---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", (p) => !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);
---

<Base title="Product designer">
  <h1>Product designer, UI/UX.</h1>
  <p class="lede">
    <em class="muted">[Cần sếp viết: giới thiệu ngắn 2-3 câu. Làm gì, cho ai, vì sao nên thuê.]</em>
  </p>

  <h2>Selected work</h2>
  {
    projects.length === 0 ? (
      <div class="empty">
        Chưa có case study nào. Thêm file markdown vào <code>src/content/projects/</code>.
      </div>
    ) : (
      <ul class="entries">
        {projects.map((p) => (
          <li>
            <a class="entry-title" href={`/projects/${p.id}/`}>
              {p.data.title}
            </a>
            <div class="entry-meta">
              {p.data.role} · {p.data.year}
              {p.data.client ? ` · ${p.data.client}` : ""}
            </div>
            <p class="entry-note">{p.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }

  <h2>Products</h2>
  <p class="faint">Figma templates, plugins, AI skills, open source.</p>
  <p><a href="/products/">Xem tất cả →</a></p>

  <hr />

  <h2>Liên hệ</h2>
  <p>
    Nhận freelance UI/UX. Email <a href="mailto:kafka@ontheshore.biz">kafka@ontheshore.biz</a>.
  </p>
</Base>
